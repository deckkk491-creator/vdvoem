{
  "expo": {
    "name": "Вместе",
    "slug": "vdvoem",
    "scheme": "vdvoem",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#FBF4EC",
    "ios": {
      "bundleIdentifier": "com.deckkk491.vdvoem",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleDevelopmentRegion": "ru"
      }
    },
    "android": {
      "package": "com.deckkk491.vdvoem",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/adaptive-icon-monochrome.png",
        "backgroundColor": "#E0623A"
      },
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#FBF4EC",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#17110E"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#E0623A"
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "«Вместе» добавит твои общие события, задачи и важные даты в календарь «Вместе» — только если ты включишь это в разделе «Календарь».",
          "remindersPermission": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "«Вместе» открывает галерею, чтобы ты мог прикрепить фото к свиданию, поездке, событию или отправить его в чат.",
          "cameraPermission": "«Вместе» использует камеру, чтобы ты мог сфотографировать и прикрепить снимок к записи или сообщению.",
          "microphonePermission": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "«Вместе» использует микрофон, чтобы ты мог записать голосовое сообщение в чат."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "locales": {
      "ru": "./locales/ru.json"
    }
  }
}

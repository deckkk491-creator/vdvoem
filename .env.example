# Скопируйте этот файл в .env и вставьте значения из Supabase:
# Project Settings → API → Project URL и anon public key
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
# Ссылка на политику конфиденциальности (нужна для App Store).
# Необязательно: по умолчанию — страница из /docs на GitHub Pages.
EXPO_PUBLIC_PRIVACY_URL=https://deckkk491-creator.github.io/vdvoem/privacy-policy.html
